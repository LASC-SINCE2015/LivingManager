@startuml er
!pragma layout smetana
' Firestore のコレクションの関係（ER 図）。purchase は items の中のマップ
skinparam defaultFontName "Meiryo"
hide circle

entity "users" as users {
  * uid : ドキュメント ID
  --
  displayName : string
  itemOrder : map（カテゴリ ID → アイテム ID の配列）
  createdAt : timestamp
  updatedAt : timestamp
}

entity "categories" as categories {
  * id : ドキュメント ID（water / other は固定）
  --
  name : string
  order : number
  createdAt : timestamp
  updatedAt : timestamp
}

entity "items" as items {
  * id : ドキュメント ID
  --
  name : string
  categoryId : string
  status : sufficient / low / empty
  memo : string
  purchase : map または null
  createdAt : timestamp
  updatedAt : timestamp
  updatedByUid : string
  updatedByName : string
}

entity "purchase（items 内のマップ）" as purchase {
  state : planned / in_cart
  byUid : string
  byName : string
  at : timestamp
}

entity "feedback" as feedback {
  * id : ドキュメント ID
  --
  type : bug / request / other
  body : string
  appVersion : string
  byUid : string
  byName : string
  createdAt : timestamp
  status : open / in_progress / done / wont_fix
  devMemo : string
  statusUpdatedAt : timestamp
}

entity "allowedUsers" as allowedUsers {
  * email : ドキュメント ID（小文字）
  --
  memo : string
  admin : bool
  approvedAt : timestamp
}

entity "accessRequests" as accessRequests {
  * email : ドキュメント ID（小文字）
  --
  uid : string
  displayName : string
  requestedAt : timestamp
}

categories ||--o{ items : categoryId
accessRequests ..> allowedUsers : 承認で追加（依頼は削除）
users ||--o{ feedback : byUid
users ||--o{ items : updatedByUid
items ||--o| purchase : purchase
users ||--o{ purchase : byUid
users }o..o{ items : itemOrder（自分の並び順）
@enduml
