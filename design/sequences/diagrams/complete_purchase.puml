@startuml complete_purchase
!pragma layout smetana
' 購入完了（自分のカゴ済みをまとめて「十分」に戻す）の流れ
skinparam defaultFontName "Meiryo"
autonumber

actor "家族" as user
participant "ShoppingListPage" as page
participant "ItemsRepository" as repo
database "Firestore" as fs

user -> page : 「購入完了（N件）」
page -> page : 対象 = 自分のカゴ済みのアイテム
page -> user : 確認ダイアログ「N件を購入完了にしますか？」
user --> page : 購入完了
page -> repo : completePurchase(対象, 自分)
repo -> fs : WriteBatch\n各アイテム: status = sufficient,\npurchase = null, 更新者 = 自分
fs --> repo : コミット成功（全件まとめて）
repo --> page : 完了
page -> user : 「N件を購入完了にしました」
fs -> page : snapshots で一覧を更新（全員の画面から消える）
@enduml
